{
  "name": "naver-blog-auto-fill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install-browser": "npx playwright install chromium",
    "start": "node naver-auto-fill.js",
    "server": "node server.js",
    "open": "node -e \"fetch('http://localhost:3333/open-browser?write=1',{method:'POST'}).then(r=>r.text()).then(console.log).catch(console.error)\"",
    "run-auto": "node -e \"fetch('http://localhost:3333/run-automation',{method:'POST'}).then(r=>r.text()).then(console.log).catch(console.error)\""
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "express": "^4.21.2",
    "cors": "^2.8.5"
  }
}